  {
   "cell_type": "code",
   "execution_count": 38,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ConvNet(nn.Module):\n",
    "\n",
    "    def __init__(self):\n",
    "        '''\t\n",
    "        Initializes the convolutional neural network model.\n",
    "\n",
    "        Args:\n",
    "            None\n",
    "        '''\n",
    "\n",
    "        super(ConvNet, self).__init__()\n",
    "\n",
    "        self.conv_blocks = nn.Sequential(\n",
    "            nn.Conv2d(3, 6, kernel_size=5),  # C1: input 3 channels (color), 6 filters\n",
    "            nn.ReLU(),                    # Activation\n",
    "            nn.AvgPool2d(kernel_size=2),     # S2: Average pooling\n",
    "            \n",
    "            nn.Conv2d(6, 16, kernel_size=5),  # C3: 6 input channels, 16 filters\n",
    "            nn.ReLU(),                    # Activation\n",
    "            nn.AvgPool2d(kernel_size=2),     # S4: Average pooling\n",
    "            \n",
    "            nn.Conv2d(16, 120, kernel_size=5), # C5: 16 input channels, 120 filters\n",
    "            nn.ReLU(),                    # Activation\n",
    "        )\n",
    "\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Flatten(),                   # Flatten the output\n",
    "            nn.Linear(120 * 9 * 9, 84),  # F6: Fully connected layer\n",
    "            nn.ReLU(),          # Activation\n",
    "            nn.Linear(84, 100) # Output layer: 100 classes\n",
    "        )\n",
    "\n",
    "        \n",
    "\n",
    "    def forward(self, x):\n",
    "        '''\n",
    "        Defines the forward pass of the neural network.\n",
    "\n",
    "        Args:\n",
    "            x (torch.Tensor): The input tensor.\n",
    "\n",
    "        Returns:\n",
    "            torch.Tensor: The output tensor.\n",
    "        '''\n",
    "\n",
    "        # x = self.conv_block_1(x)\n",
    "        # x = self.conv_block_2(x)\n",
    "        # x = self.conv_block_3(x)\n",
    "        # x = self.classifier(x)\n",
    "        return self.classifier(self.conv_blocks(x))\n"
   ]
  },
